<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, edge-to-edge; colours match the car page. The UI is built in code (ui/Ui.kt). -->
    <style name="Theme.Carlink" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/carlink_bg</item>
        <item name="android:colorAccent">@color/carlink_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <color name="carlink_bg">#FF121212</color>
    <color name="carlink_accent">#FF8AB4F8</color>
</resources>
