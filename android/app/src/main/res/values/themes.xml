<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, edge-to-edge; colours match the car page. The UI is built in code (ui/Ui.kt). -->
    <style name="Theme.TSLink" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/tslink_bg</item>
        <item name="android:colorAccent">@color/tslink_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <color name="tslink_bg">#FF121212</color>
    <color name="tslink_accent">#FF8AB4F8</color>
</resources>
